+size_t IOFile::ReadAt(void* data, size_t length, s64 offset) const {
+    if (!IsOpen()) {
+        return 0;
+    }
+#ifdef _WIN32
+    if (fseeko(file, offset, SEEK_SET) != 0) {
+        return 0;
+    }
+    return std::fread(data, 1, length, file);
+#else
+    const int fd = fileno(file);
+    size_t done = 0;
+    while (done < length) {
+        const auto got = pread(fd, static_cast<u8*>(data) + done, length - done,
+                               static_cast<off_t>(offset + static_cast<s64>(done)));
+        if (got < 0 && errno == EINTR) {
+            continue;
+        }
+        if (got <= 0) {
+            break;
+        }
+        done += static_cast<size_t>(got);
+    }
+    return done;
+#endif
