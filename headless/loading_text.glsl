// One word of a glyph's field.
uint glyph_word(int glyph, int word)
{
    switch (glyph)
    {
    case 0: return kGlyph0[word];
    case 1: return kGlyph1[word];
    case 2: return kGlyph2[word];
    case 3: return kGlyph3[word];
    case 4: return kGlyph4[word];
    case 5: return kGlyph5[word];
    case 6: return kGlyph6[word];
    case 7: return kGlyph7[word];
    case 8: return kGlyph8[word];
    case 9: return kGlyph9[word];
    case 10: return kGlyph10[word];
    case 11: return kGlyph11[word];
    case 12: return kGlyph12[word];
    case 13: return kGlyph13[word];
    case 14: return kGlyph14[word];
    case 15: return kGlyph15[word];
